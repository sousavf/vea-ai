{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vea.dev/schemas/plugin-manifest-v1.json",
  "title": "Vea extension manifest",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestVersion",
        "id",
        "displayName",
        "version",
        "digest",
        "plane",
        "source",
        "capabilities"
      ],
      "properties": {
        "manifestVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/displayName" },
        "version": { "$ref": "#/$defs/version" },
        "digest": { "$ref": "#/$defs/digest" },
        "homepage": { "$ref": "#/$defs/homepage" },
        "plane": { "const": "skill" },
        "source": { "type": "string", "minLength": 1 },
        "capabilities": { "type": "array", "maxItems": 0 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestVersion",
        "id",
        "displayName",
        "version",
        "digest",
        "plane",
        "transport",
        "capabilities",
        "reviewed"
      ],
      "properties": {
        "manifestVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/displayName" },
        "version": { "$ref": "#/$defs/version" },
        "digest": { "$ref": "#/$defs/digest" },
        "homepage": { "$ref": "#/$defs/homepage" },
        "plane": { "const": "mcp" },
        "transport": { "enum": ["stdio", "streamable-http"] },
        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
        "reviewed": { "type": "boolean" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestVersion",
        "id",
        "displayName",
        "version",
        "digest",
        "plane",
        "entrypoint",
        "facadeRange",
        "capabilities"
      ],
      "properties": {
        "manifestVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/displayName" },
        "version": { "$ref": "#/$defs/version" },
        "digest": { "$ref": "#/$defs/digest" },
        "homepage": { "$ref": "#/$defs/homepage" },
        "plane": { "const": "restricted-plugin" },
        "entrypoint": { "type": "string", "minLength": 1 },
        "facadeRange": { "type": "string", "minLength": 1 },
        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" } }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestVersion",
        "id",
        "displayName",
        "version",
        "digest",
        "plane",
        "package",
        "privileged",
        "capabilities"
      ],
      "properties": {
        "manifestVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/displayName" },
        "version": { "$ref": "#/$defs/version" },
        "digest": { "$ref": "#/$defs/digest" },
        "homepage": { "$ref": "#/$defs/homepage" },
        "plane": { "const": "pi-compat" },
        "package": { "type": "string", "minLength": 1 },
        "privileged": { "const": true },
        "capabilities": { "const": "full-system-access" }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,127}$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "homepage": { "type": "string", "format": "uri" },
    "capability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "globs"],
          "properties": {
            "kind": { "enum": ["project.read", "project.propose-write"] },
            "globs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "hosts"],
          "properties": {
            "kind": { "const": "network" },
            "hosts": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operations"],
          "properties": {
            "kind": { "const": "provider" },
            "operations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "surfaces"],
          "properties": {
            "kind": { "const": "ui" },
            "surfaces": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      ]
    }
  }
}
